# Copy this file to .env and fill in real values. Never commit .env.

# Database: PostgreSQL via docker compose (default)
DATABASE_URL=postgresql+psycopg://slotsaver:slotsaver@localhost:5432/slotsaver
# No Docker? Use SQLite instead (one file, no setup):
# DATABASE_URL=sqlite:///./slotsaver.db

# Frontend origin allowed to call the API
CORS_ORIGINS=http://localhost:5173

# LLM (Pratik): fake value, put your real key only in .env
LLM_API_KEY=your-api-key-here

# Slack alert (Jatin): fake value
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
